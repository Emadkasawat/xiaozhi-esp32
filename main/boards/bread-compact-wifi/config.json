{
    "type": "bread-compact-wifi",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X32=y"
            ]
        },
        {
            "name": "bread-compact-wifi-128x64",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X64=y"
            ]
        },
        {
            "name": "bread-compact-wifi-sh1106",
            "sdkconfig_append": [
                "CONFIG_OLED_SH1106_128X64=y",
                "CONFIG_LV_USE_BIDI=y",
                "CONFIG_LV_BIDI_DIR_AUTO=y"
            ]
        }
    ]
}